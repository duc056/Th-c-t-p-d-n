@model IEnumerable<ClinicBook.Models.LichSuLichHen>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TrangThaiCu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrangThaiMoi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ThoiGianThayDoi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GhiChu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaLichHenNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaTaiKhoanNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TrangThaiCu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TrangThaiMoi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ThoiGianThayDoi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GhiChu)
            </td>
            <td>
                @(item.MaLichHenNavigation == null ? "Không có" : item.MaLichHenNavigation.MaLichHen.ToString())
            </td>
            <td>
                @(item.MaTaiKhoanNavigation == null ? "Không có" : item.MaTaiKhoanNavigation.MaTaiKhoan.ToString())
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MaLichSu">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MaLichSu">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MaLichSu">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>


