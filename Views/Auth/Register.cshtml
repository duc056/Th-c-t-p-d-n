@model ClinicBook.ViewModels.RegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "Dang ky ClinicBook";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #e8f2ff, #f5f8fc);
            font-family: Arial, sans-serif;
            padding: 35px 12px;
        }
        .register-card {
            max-width: 650px;
            margin: auto;
            padding: 32px;
            border-radius: 18px;
            background: white;
            box-shadow: 0 10px 35px rgba(0,0,0,.09);
        }
        .logo {
            width: 58px;
            height: 58px;
            margin: 0 auto 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: #0d6efd;
            color: white;
            font-size: 27px;
            font-weight: bold;
        }
        .form-control, .form-select { padding: 10px 12px; }
    </style>
</head>
<body>
    <div class="register-card">
        <div class="text-center mb-4">
            <div class="logo">C</div>
            <h3 class="fw-bold">ClinicBook</h3>
            <p class="text-muted">Tao tai khoan benh nhan</p>
        </div>

        <form asp-controller="Auth" asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="HoTen" class="form-label"></label>
                    <input asp-for="HoTen" class="form-control" placeholder="Nhap ho va ten" />
                    <span asp-validation-for="HoTen" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TenDangNhap" class="form-label"></label>
                    <input asp-for="TenDangNhap" class="form-control" placeholder="Tu 4 ky tu tro len" />
                    <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="example@email.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SoDienThoai" class="form-label"></label>
                    <input asp-for="SoDienThoai" class="form-control" placeholder="Nhap so dien thoai" />
                    <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MatKhau" class="form-label"></label>
                    <input asp-for="MatKhau" class="form-control" placeholder="It nhat 8 ky tu" />
                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="XacNhanMatKhau" class="form-label"></label>
                    <input asp-for="XacNhanMatKhau" class="form-control" placeholder="Nhap lai mat khau" />
                    <span asp-validation-for="XacNhanMatKhau" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="NgaySinh" class="form-label"></label>
                    <input asp-for="NgaySinh" type="date" class="form-control" />
                    <span asp-validation-for="NgaySinh" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="GioiTinh" class="form-label"></label>
                    <select asp-for="GioiTinh" class="form-select">
                        <option value="">-- Chon gioi tinh --</option>
                        <option value="Nam">Nam</option>
                        <option value="Nu">Nu</option>
                        <option value="Khac">Khac</option>
                    </select>
                    <span asp-validation-for="GioiTinh" class="text-danger"></span>
                </div>
                <div class="col-12 mb-3">
                    <label asp-for="DiaChi" class="form-label"></label>
                    <textarea asp-for="DiaChi" class="form-control" rows="2" placeholder="Nhap dia chi"></textarea>
                    <span asp-validation-for="DiaChi" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                Dang ky tai khoan
            </button>
        </form>

        <div class="text-center mt-3">
            <span class="text-muted">Da co tai khoan?</span>
            <a asp-controller="Auth" asp-action="Login" class="text-decoration-none">Dang nhap</a>
        </div>
    </div>
</body>
</html>
