@model IEnumerable<ClinicBook.Models.LichHen>

@{
    ViewData["Title"] = "Danh sách lịch hẹn";
    var laBenhNhan = User.IsInRole("BenhNhan");
    var coQuyenQuanLy = User.IsInRole("QuanTriVien") || User.IsInRole("NhanVienTiepNhan");
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Danh sách lịch hẹn</h2>
            <p class="text-muted mb-0">Theo dõi thông tin và trạng thái lịch khám</p>
        </div>

        @if (laBenhNhan)
        {
            <a asp-action="DatLich" class="btn btn-primary">
                + Đặt lịch khám
            </a>
        }
        else if (coQuyenQuanLy)
        {
            <a asp-action="Create" class="btn btn-primary">
                + Tạo lịch hẹn
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã lịch</th>
                            <th>Thời gian bắt đầu</th>
                            <th>Thời gian kết thúc</th>
                            <th>Lý do khám</th>
                            <th>Trạng thái</th>
                            @if (!laBenhNhan)
                            {
                                <th>Bệnh nhân</th>
                            }
                            <th>Bác sĩ</th>
                            <th>Phòng khám</th>
                            <th>Ngày đặt</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.MaLichHen</td>
                                    <td>@item.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.ThoiGianKetThuc.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.LyDoKham</td>
                                    <td>
                                        @if (item.TrangThai == "ChoXacNhan")
                                        {
                                            <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                                        }
                                        else if (item.TrangThai == "DaHuy")
                                        {
                                            <span class="badge bg-danger">Đã hủy</span>
                                        }
                                        else if (item.TrangThai == "DaXacNhan")
                                        {
                                            <span class="badge bg-success">Đã xác nhận</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.TrangThai</span>
                                        }
                                    </td>

                                    @if (!laBenhNhan)
                                    {
                                        <td>@item.MaBenhNhanNavigation?.MaTaiKhoanNavigation?.HoTen</td>
                                    }

                                    <td>@item.MaBacSiNavigation?.MaTaiKhoanNavigation?.HoTen</td>
                                    <td>@item.MaPhongKhamNavigation?.TenPhongKham</td>
                                    <td>@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <a asp-action="Details"
                                               asp-route-id="@item.MaLichHen"
                                               class="btn btn-sm btn-outline-info">
                                                Chi tiết
                                            </a>

                                            @if (coQuyenQuanLy)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.MaLichHen"
                                                   class="btn btn-sm btn-outline-primary">
                                                    Sửa
                                                </a>
                                            }

                                            @if (laBenhNhan &&
                                                 item.TrangThai == "ChoXacNhan" &&
                                                 item.ThoiGianBatDau > DateTime.Now)
                                            {
                                                <form asp-action="HuyLichBenhNhan"
                                                      method="post"
                                                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy lịch hẹn này không?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.MaLichHen" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        Hủy lịch
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(!laBenhNhan ? 10 : 9)" class="text-center text-muted py-4">
                                    Không có dữ liệu lịch hẹn nào.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
