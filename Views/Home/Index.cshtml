
@{
    ViewData["Title"] = "ClinicBook";
}

<div class="container py-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <span class="badge bg-info-subtle text-info mb-3">
                HỆ THỐNG QUẢN LÝ PHÒNG KHÁM
            </span>

            <h1 class="display-4 fw-bold mb-3">
                Chăm sóc sức khỏe<br />
                <span class="text-primary">dễ dàng hơn</span>
            </h1>

            <p class="text-secondary fs-5 mb-4">
                ClinicBook hỗ trợ quản lý thông tin bệnh nhân, bác sĩ,
                chuyên khoa và đặt lịch khám trực tuyến một cách thuận tiện.
            </p>

            <a asp-controller="Auth" asp-action="Login"
               class="btn btn-primary btn-lg px-4">
                Đăng nhập hệ thống
            </a>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow p-5 text-center">
                <div class="display-1 text-primary mb-3">✚</div>
                <h2 class="fw-bold text-primary">ClinicBook</h2>
                <p class="text-secondary mb-0">
                    Đồng hành cùng bạn trong việc chăm sóc sức khỏe.
                </p>
            </div>
        </div>
    </div>
</div>
