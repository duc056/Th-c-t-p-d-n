@model ClinicBook.Models.BacSi

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>BacSi</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.HocVi)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.HocVi)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.KinhNghiem)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.KinhNghiem)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.GioiThieu)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.GioiThieu)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TrangThai)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TrangThai)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MaPhongKhamNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MaPhongKhamNavigation.MaPhongKham)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MaTaiKhoanNavigation)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MaTaiKhoanNavigation.MaTaiKhoan)
        </dd>
    </dl>
    
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.MaBacSi" />

        <button type="submit" class="btn btn-danger">
            Xác nhận xóa
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Quay lại
        </a>
    </form>
</div>
