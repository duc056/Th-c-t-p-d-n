@model IEnumerable<ClinicBook.Models.BacSi>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close"
                data-bs-dismiss="alert"></button>
    </div>
}
@{
    ViewData["Title"] = "Danh sách bác sĩ";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalItems = ViewBag.TotalItems ?? 0;
    string search = ViewBag.Search as string ?? "";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Danh sách bác sĩ</h2>
            <p class="text-muted mb-0">Quản lý thông tin đội ngũ bác sĩ</p>
        </div>
        @if (User.IsInRole("QuanTriVien"))
        {
            <a asp-action="Create" class="btn btn-primary">
                + Thêm bác sĩ
            </a>
        }
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2">
                <div class="col-md-9">
                    <input type="text"
                           name="search"
                           value="@search"
                           class="form-control"
                           placeholder="Tìm theo họ tên, email, tài khoản, số điện thoại hoặc học vị..." />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Tìm kiếm
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Làm mới
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between mb-2">
        <span class="text-muted">
            Tổng số: <strong>@totalItems</strong> bác sĩ
        </span>
        <span class="text-muted">
            Trang @currentPage / @Math.Max(totalPages, 1)
        </span>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>STT</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Học vị</th>
                        <th>Kinh nghiệm</th>
                        <th>Phòng khám</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        int stt = (currentPage - 1) * (ViewBag.PageSize ?? 10) + 1;

                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@stt</td>
                                <td>
                                    <strong>
                                        @(item.MaTaiKhoanNavigation?.HoTen ?? "Chưa cập nhật")
                                    </strong>
                                </td>
                                <td>
                                    @(item.MaTaiKhoanNavigation?.Email ?? "Chưa cập nhật")
                                </td>
                                <td>
                                    @(item.MaTaiKhoanNavigation?.SoDienThoai ?? "Chưa cập nhật")
                                </td>
                                <td>@(item.HocVi ?? "Chưa cập nhật")</td>
                                <td>@(item.KinhNghiem?.ToString() ?? "Chưa cập nhật")</td>
                                <td>
                                    @(item.MaPhongKhamNavigation?.MaPhongKham.ToString() ?? "Chưa cập nhật")
                                </td>
                                <td>
                                    @if (item.TrangThai == true)
                                    {
                                        <span class="badge bg-success">Đang hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngừng hoạt động</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details"
                                           asp-route-id="@item.MaBacSi"
                                           class="btn btn-outline-info">
                                            Chi tiết
                                        </a>

                                        @if (User.IsInRole("QuanTriVien"))
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.MaBacSi"
                                               class="btn btn-outline-primary">
                                                Sửa
                                            </a>
                                            <a asp-action="Delete"
                                               asp-route-id="@item.MaBacSi"
                                               class="btn btn-outline-danger">
                                                Xóa
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                Không tìm thấy bác sĩ phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@search"
                       asp-route-page="@(currentPage - 1)">
                        Trước
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-page="@i">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@search"
                       asp-route-page="@(currentPage + 1)">
                        Sau
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
