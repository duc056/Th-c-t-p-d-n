@model ClinicBook.Models.BacSiChuyenKhoa

@{
    ViewData["Title"] = "Phân công chuyên khoa";
}

<div class="container mt-4">
    <h2>Phân công chuyên khoa cho bác sĩ</h2>
    <p class="text-muted">Chọn bác sĩ và chuyên khoa muốn phân công.</p>
    <hr />

    <div class="row">
        <div class="col-md-7 col-lg-6">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="MaBacSi" class="form-label">Bác sĩ</label>
                    <select asp-for="MaBacSi" class="form-select"
                            asp-items="ViewBag.MaBacSi">
                        <option value="">-- Chọn bác sĩ --</option>
                    </select>
                    <span asp-validation-for="MaBacSi" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaChuyenKhoa" class="form-label">Chuyên khoa</label>
                    <select asp-for="MaChuyenKhoa" class="form-select"
                            asp-items="ViewBag.MaChuyenKhoa">
                        <option value="">-- Chọn chuyên khoa --</option>
                    </select>
                    <span asp-validation-for="MaChuyenKhoa" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="LaChuyenKhoaChinh" class="form-check-input" />
                    <label asp-for="LaChuyenKhoaChinh" class="form-check-label">
                        Đây là chuyên khoa chính
                    </label>
                </div>

                <button type="submit" class="btn btn-primary">Lưu phân công</button>
                <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
